# Browser-facing RAG API settings. VITE_RAG_API_KEY must match the API's
# SERVICE_API_KEY. All VITE_* values are visible to browser users.
VITE_RAG_API_URL=http://localhost:9000
VITE_RAG_API_KEY=change-me
VITE_RAG_TENANT_ID=jobbazaar
VITE_RAG_USER_ID=user-1

# Docker Compose host port (not read by the React application)
FRONTEND_PORT=9090
